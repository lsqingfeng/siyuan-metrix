{
  "manifest_version": 3,
  "name": "Metrix 发布伴侣",
  "short_name": "Metrix",
  "version": "2.1.2",
  "description": "无缝连接思源笔记 Metrix 插件，复用浏览器已登录会话，全自动打入知乎、掘金、CSDN、头条等平台草稿箱。",
  "author": "lsqingfeng",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "permissions": [
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://*.zhihu.com/*",
    "https://*.juejin.cn/*",
    "https://*.csdn.net/*",
    "https://*.toutiao.com/*",
    "https://*.bilibili.com/*",
    "https://*.feishu.cn/*",
    "https://*.jsdelivr.net/*",
    "https://raw.githubusercontent.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*"
      ],
      "js": [
        "src/bridge/bridge-listener.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.zhihu.com/*",
        "https://zhuanlan.zhihu.com/*",
        "https://juejin.cn/*",
        "https://editor.csdn.net/*",
        "https://mp.csdn.net/*",
        "https://mp.toutiao.com/*",
        "https://member.bilibili.com/*",
        "https://*.feishu.cn/*"
      ],
      "js": [
        "src/platforms/injector.js"
      ],
      "run_at": "document_idle"
    }
  ]
}